# Core APIs
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=

# Optional explicit config paths
AIRESEARCH_CONFIG=
AIRESEARCH_MCP_CONFIG=

# Obsidian integration
OBSIDIAN_VAULT=C:/path/to/your/ObsidianVault

# Email backend selector: auto | smtp | mcp
EMAIL_BACKEND=auto
EMAIL_ACCOUNT_NAME=default

# SMTP mode (used when EMAIL_BACKEND=smtp or auto with SMTP_HOST configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# MCP email mode (optional overrides)
MCP_EMAIL_COMMAND=
MCP_EMAIL_ARGS=stdio

# Optional Codex flags used by orchestrator
CODEX_USE_SEARCH=false
